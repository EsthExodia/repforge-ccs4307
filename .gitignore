* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #eef6ff;
  background: #07131f;
  line-height: 1.5;
  font-weight: 400;
  color-scheme: dark;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  background:
    radial-gradient(circle at top, rgba(34, 197, 94, 0.14), transparent 25%),
    linear-gradient(135deg, #06131d 0%, #0b1e2d 42%, #07161d 100%);
}

a {
  color: inherit;
  text-decoration: none;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.auth-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card {
  width: min(100%, 470px);
  background: rgba(7, 17, 26, 0.84);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 28px;
  padding: 28px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(20px);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 24px;
}

.brand-mark,
.brand-mini {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, #34d399, #22c55e);
  color: #06230d;
  font-weight: 800;
}

.brand-wrap h1 {
  margin: 4px 0 0;
  font-size: 2rem;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.7rem;
  color: #91c3ff;
}

.toggle-row {
  display: flex;
  background: rgba(14, 31, 45, 0.8);
  padding: 6px;
  border-radius: 12px;
  margin-bottom: 20px;
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.toggle {
  flex: 1;
  border: none;
  background: transparent;
  color: #dfeaf4;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 700;
}

.toggle.active {
  background: rgba(34, 197, 94, 0.18);
  color: #baf7d0;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.auth-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #e8f6ff;
  font-weight: 600;
}

.auth-form input,
.search-box {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: #eef6ff;
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
}

.auth-form input:focus,
.search-box:focus {
  border-color: rgba(52, 211, 153, 0.75);
  box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.12);
}

.primary-btn,
.secondary-btn,
.tiny-btn,
.logout-btn,
.nav-link {
  border: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn,
.secondary-btn,
.tiny-btn,
.logout-btn {
  border-radius: 12px;
  padding: 0.82rem 1.1rem;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, #34d399, #22c55e);
  color: #031b14;
}

.secondary-btn {
  background: rgba(16, 185, 129, 0.12);
  color: #b6f0d4;
  border: 1px solid rgba(52, 211, 153, 0.35);
}

.tiny-btn {
  background: rgba(96, 165, 250, 0.12);
  color: #d7ebff;
  border: 1px solid rgba(96, 165, 250, 0.28);
  padding: 0.55rem 0.8rem;
}

.logout-btn {
  background: rgba(239, 68, 68, 0.12);
  color: #fecaca;
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.feature-pills {
  margin-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.feature-pills span,
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 6px 10px;
  background: rgba(14, 116, 144, 0.12);
  border: 1px solid rgba(103, 232, 249, 0.2);
  color: #baf0ff;
  font-size: 0.75rem;
  font-weight: 700;
}

.app-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

.sidebar {
  background: rgba(7, 17, 26, 0.8);
  border-right: 1px solid rgba(148, 163, 184, 0.14);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 16px;
}

.user-card p,
.user-card h3 {
  margin: 0;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-link {
  text-align: left;
  background: transparent;
  border-radius: 12px;
  padding: 12px 14px;
  color: #dfeaf4;
  font-weight: 600;
}

.nav-link.active {
  background: rgba(34, 197, 94, 0.12);
  color: #baf7d0;
}

.main-panel {
  padding: 30px;
}

.top-row,
.subhead-row,
.template-header,
.exercise-top,
.template-spotlight {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.main-panel h2,
.main-panel h3,
.main-panel h4,
.main-panel p {
  margin-top: 0;
}

.stats-grid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 18px;
}

.stat-card,
.panel-card,
.exercise-card,
.template-card,
.tutorial-card {
  background: rgba(10, 21, 32, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 20px;
  padding: 20px;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card.accent {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.22), rgba(14, 165, 233, 0.1));
}

.stat-card strong {
  font-size: clamp(1.6rem, 2vw, 2.2rem);
}

.panel-card {
  margin-top: 20px;
}

.panel-card.full {
  min-height: 500px;
}

.template-spotlight {
  background: rgba(15, 23, 42, 0.7);
  border-radius: 18px;
  padding: 18px;
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.exercise-grid,
.template-grid,
.tutorial-grid {
  margin-top: 18px;
  display: grid;
  gap: 18px;
}

.exercise-grid {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.template-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.tutorial-grid {
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.exercise-card,
.template-card,
.tutorial-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.exercise-card ul,
.template-card ul {
  margin: 0;
  padding-left: 18px;
  color: #d9edf8;
}

.template-card.active {
  border-color: rgba(52, 211, 153, 0.5);
  box-shadow: 0 0 0 1px rgba(52, 211, 153, 0.15);
}

.video-placeholder {
  height: 120px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(16, 185, 129, 0.18));
  border: 1px solid rgba(96, 165, 250, 0.2);
  color: #dbeafe;
  font-weight: 700;
}

.link-btn {
  display: inline-block;
  width: fit-content;
}

.search-box {
  width: min(260px, 100%);
}

.plan-list {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  border-radius: 16px;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.plan-item.done {
  opacity: 0.7;
  background: rgba(34, 197, 94, 0.08);
}

.plan-item h4,
.plan-item p {
  margin: 0;
}

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .main-panel {
    padding: 18px;
  }
}

@media (max-width: 640px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .top-row,
  .subhead-row,
  .template-header,
  .exercise-top,
  .template-spotlight {
    flex-direction: column;
    align-items: flex-start;
  }

  .search-box {
    width: 100%;
  }
}
